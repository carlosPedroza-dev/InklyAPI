# ============================================================
# Inkly — .gitignore
# .NET 8 Clean Architecture + PostgreSQL + Docker
# ============================================================

# ============================================================
# SECRETS — never commit these
# ============================================================
.env
.env.*
.env.local
.env.development
.env.production
*.env

# .NET User Secrets (local dev secrets)
secrets.json
appsettings.Development.json
appsettings.Local.json
appsettings.Production.json

# API keys / config that might be hardcoded by mistake
**/appsettings.*.json
!**/appsettings.json
# ↑ allows the base appsettings.json (no secrets there)
# ↑ blocks appsettings.Development.json, appsettings.Production.json etc.

# ============================================================
# .NET BUILD OUTPUT
# ============================================================
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# NuGet packages (restored automatically — never commit these)
*.nupkg
*.snupkg
.nuget/
packages/
project.lock.json
project.fragment.lock.json
artifacts/

# MSBuild
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# ============================================================
# VISUAL STUDIO / RIDER / VS CODE
# ============================================================

# Visual Studio
.vs/
*.rsuser
*.vspx
*.sap

# Rider (JetBrains)
.idea/
*.iml
*.iws
*.ipr
.idea_modules/

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# ============================================================
# EF CORE — keep migrations, ignore runtime files
# ============================================================

# Never ignore Migrations/ folder — those are source code
# !**/Migrations/

# EF Core design-time files (auto-generated, not needed in repo)
*.Designer.cs

# ============================================================
# TESTING
# ============================================================
TestResults/
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml
coverage/
coverage-reports/

# TestContainers local cache
.testcontainers/

# ============================================================
# DOCKER
# ============================================================

# Docker override files (local dev overrides — not for prod)
docker-compose.override.yml
docker-compose.local.yml

# Docker volumes mounted locally
postgres_data/
pgadmin_data/

# ============================================================
# OPERATING SYSTEM
# ============================================================

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Windows
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.nfs*

# ============================================================
# LOGS & RUNTIME
# ============================================================
*.log
*.log.*
nohup.out
crash.log
crash.*.log

# ASP.NET Core Data Protection keys (generated at runtime)
DataProtection-Keys/

# ============================================================
# CERTIFICATES & KEYS — extremely sensitive
# ============================================================
*.pfx
*.p12
*.pem
*.key
*.crt
*.cer
*.der
*.p7b

# HTTPS dev certificate (auto-generated by dotnet dev-certs)
*.pfx

# ============================================================
# MISC
# ============================================================

# Backup files
*.bak
*.tmp
*.temp
*.swp
*.orig

# Compressed files (shouldn't be in source control)
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# JetBrains Rider decompiled sources
**/csharp/
**/.editorconfig.generated

# Benchmarks output
BenchmarkDotNet.Artifacts/

# NuGet Symbol packages
*.snupkg

# Roslyn analyzers
.roslynator/